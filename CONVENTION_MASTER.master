        :root {
            --bg: #feebd4;
            --link: #002e5d;
            --hover: #0074D9;
        }

        nav {
            background: var(--bg);
            padding: 0 1rem;
            /*margin-top : 160px;*/
        }

        .menu {
            max-width: 1200px;
            margin: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            justify-content: space-between;
            width: 100% !important;
        }

        .logo {
            color: var(--link);
            font-size: 1.5rem;
            padding: 1rem 0;
        }

        .hamburger {
            display: none;
            font-size: 2rem;
            color: var(--link);
            cursor: pointer;
        }

        .menu-links {
            display: flex;
            list-style: none;
            gap: 1rem;
            font-weight: bold;
            margin-bottom: 0px;
            width: 100%;
            justify-content: space-between;
        }

            .menu-links li {
                position: relative;
            }

            .menu-links a {
                color: var(--link);
                text-decoration: none;
                padding: 1rem 0.5rem;
                display: block;
                font-size: 18px;
            }

            .menu-links li:hover > a {
                background: #002e5d;
                color: white;
            }

            /* Dropdown hidden by default */
            .menu-links li ul {
                display: none;
                position: absolute;
                top: 100%;
                left: 0;
                background: var(--bg);
                min-width: 200px;
                list-style: none;
                z-index: 999;
            }

                .menu-links li ul a {
                    font-size: 16px;
                }

        /* Hover behavior for desktop */
        @media (min-width: 769px) {
            .menu-links li:hover > ul {
                display: block;
            }
        }

        .menu-links li ul li {
            border-top: 1px solid rgba(255, 255, 255, 0.2);
        }

        /* Mobile Styles */
        @media (max-width: 768px) {
            .hamburger {
                display: block;
                padding: 1rem 0;
            }
            .menu-toggle {
                display: block;
                padding: 1rem 0;
                margin-left: -13px;
            }
            .sidebar {
                top: 191px !important;
                           margin-top: -30%;
    height: 50%;
    width: 100% !important;
    margin-left: 100%;
    transition: all 0.3s;
}
            .member_select_name {
                margin-left: auto;
    width: 100px;
    margin-right: -25px;
            }
            .member_select_name p {
                width : 100%;
            }
            .member_profile_pic {
                width :10%;
            }

            profile_menu_ul  {
                margin-top: 16px;
    margin-left: -50px;
            }
            .menu-links {
                display: none;
                flex-direction: column;
                width: 100%;
            }

                .menu-links.show {
                    display: flex;
                }

                .menu-links li ul {
                    position: static;
                }

                .menu-links li.show-dropdown > ul {
                    display: block;
                }
        }

        .logo_div img {
            width: 100% !important;
        }

        @media(max-width:991px) {
            .logo_div {
                display: none !important;
            }
        }



        @media(min-width:992px) {
            .mob_logo {
                display: none;
            }
        }

        .convention_home_main {
            width: 100% !important;
            max-width: 1170px !important;
            padding-inline: 15px !important;
        }

        .member_select_name {
            background-color: #002e5d;
        }

        .profile_menu_ul {
            background-color: white;
        }
    </style>
    <style>
        #head_main {
           /* position: fixed !important;*/
            top: 0;
            left: 0;
            right: 0;
              
        }

        #sidebar {
            z-index: 1000;
        }

        .logmod__wrapper {
            position: relative;
            z-index: 1; /* Ensure login form appears above sidebar */
        }
        /* Sidebar styles */
        :root {
            --sidebar-width: 250px;
            --sidebar-bg: #08503f;
            --sidebar-color: #fff;
            --sidebar-hover-bg: #0a6a54;
            --sidebar-active-bg: #002e5d;
        }

        .sidebar {
            display: none;
            position: fixed;
            left: 0;
            bottom: 0;
            width: var(--sidebar-width);
            background-color: #002e5d;
            color: var(--sidebar-color);
            z-index: 1000;
            overflow-y: auto;
            transition: all 0.3s;

        }

            .sidebar.active {
                display: block;
            }

        .sidebar-header {
            padding: 10px 20px;
            margin-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

            .sidebar-header img {
                max-width: 100%;
                height: auto;
            }

        .sidebar-menu {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .sidebar-menu li {
                position: relative;
            }

                .sidebar-menu li a {
                    display: block;
                    padding: 12px 20px;
                    color: var(--sidebar-color);
                    text-decoration: none;
                    transition: all 0.3s;
                }

                    .sidebar-menu li a:hover,
                    .sidebar-menu li a.active {
                        background: #04536c;
                    }


                    .sidebar-menu li a i {
                        margin-right: 10px;
                        width: 20px;
                        text-align: center;
                    }

            .sidebar-menu .dropdown-menu {
                position: static;
                float: none;
                width: 100%;
                padding: 0;
                margin: 0;
                background-color: transparent;
                border: none;
                border-radius: 0;
                box-shadow: none;
            }

            .sidebar-menu .dropdown-item {
                padding: 10px 20px 10px 40px;
                color: var(--sidebar-color);
            }

                .sidebar-menu .dropdown-item:hover {
                    background: var(--sidebar-hover-bg);
                }

            .sidebar-menu .dropdown-toggle::after {
                float: right;
                margin-top: 8px;
            }

        /* Main content area */
        .main-content {
            padding: 20px;
            min-height: 100vh;
            background: #f8f9fa;
        }

        /* Toggle button */
        .menu-toggle {
            top: 10px;
            left: 10px;
            z-index: 1100;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 25px;
            padding: 5px 15px;
            cursor: pointer;
            background: #002e5d !important;
            /* display: block !important; */
            /* visibility: visible !important; */
            /* opacity: 1 !important; */
        }

        }

        /* Collapsed state */
        body.collapsed {
            padding-left: 60px;
        }

            body.collapsed .sidebar {
                width: 60px;
                overflow: hidden;
            }

            body.collapsed .sidebar-header,
            body.collapsed .sidebar-menu span,
            body.collapsed .dropdown-toggle::after {
                display: none;
            }

            body.collapsed .sidebar-menu li a {
                text-align: center;
                padding: 12px 5px;
            }

                body.collapsed .sidebar-menu li a i {
                    margin-right: 0;
                    font-size: 1.2rem;
                }

            body.collapsed .dropdown-menu {
                position: absolute;
                left: 60px;
                top: 0;
                width: 200px;
                background: var(--sidebar-bg);
                display: none;
            }

            body.collapsed .sidebar-menu li:hover > .dropdown-menu {
                display: block;
            }

        /* Responsive styles */
        @media (max-width: 768px) {
            body {
                padding-left: 0;
            }

            .sidebar {
                left: -100%;
            }

            body.show-sidebar {
                overflow: hidden;
            }

                body.show-sidebar .sidebar {
                    left: 0;
                    width: var(--sidebar-width);
                }

            .menu-toggle {
                display: block;
            }
        }


        .topbar{
            flex-wrap:nowrap !important;
        }
    </style>
    <script type="text/javascript">
        function countChar(val) {
            var len = val.value.length;
            if (len > 140) {
                val.value = val.value.substring(0, 140);
            } else {
                $('#charNum').text(140 - len);
            }
        };
    </script>
    <link href="css/UpgadedCss/Main.css" rel="stylesheet" />
    <%--<link href="../css/font-awesome.min.css" rel="stylesheet" type="text/css" />
    <link href="css/font-awesome.css" rel="stylesheet" type="text/css" />--%>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans&display=swap" rel="stylesheet" />
    <script>
    function dashboard() {
            window.addEventListener('DOMContentLoaded', () => {
                const header = document.getElementById('head_main');
                const sidebar = document.querySelector(".sidebar");
                const head_main = document.querySelector("#head_main");
                const body_main = document.querySelector(".body-main");
                const headerHeight = header.offsetHeight;

                sidebar.style.top = `${headerHeight}px`;
                body_main.style.paddingTop = `${headerHeight}px`;
                head_main.style.position = "fixed";
            });
        }
    </script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

