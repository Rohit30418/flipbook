                </div>

                <div class="row">
                    <div class="col-md-6 contact_6_div" style="text-align: left">

                        <div class="contact_person">
                            <h4>Payal Swami</h4>
                            <p>Assistant Secretary General, FHRAI</p>
                            <p><span>Email:</span> <a href="mailto:asg@fhrai.com">asg@fhrai.com</a></p>
