                    <div class="col-md-6 col-sm-6 col-xs-6 contact_6_div form_6_div" style="display: none">
                        <div class="write_us">
                            <h4>WRITE TO US</h4>
                        </div>
                        <div class="contact_form">
                            <asp:TextBox ID="txtName" runat="server" CssClass="contact_input" placeholder="YOUR NAME" MaxLength="100"></asp:TextBox>
                            <asp:RequiredFieldValidator ID="rfvName" runat="server" ControlToValidate="txtName"
                                ErrorMessage="Please Enter Name" SetFocusOnError="true" Display="None"
                                ValidationGroup="vgContact"></asp:RequiredFieldValidator>
                            <asp:TextBox ID="txtEmail" runat="server" CssClass="contact_input" placeholder="YOUR EMAIL" MaxLength="150"></asp:TextBox>
                            <asp:RequiredFieldValidator ID="rfvEmail" runat="server" ControlToValidate="txtEmail"
                                ErrorMessage="Please Enter Email" SetFocusOnError="true" Display="None"
                                ValidationGroup="vgContact"></asp:RequiredFieldValidator>
                            <asp:RegularExpressionValidator ID="revEmail" runat="server" ControlToValidate="txtEmail"
                                ErrorMessage="Please Enter Valid Email" SetFocusOnError="true" Display="None" ValidationExpression="\w+([-+.']\w+)*@\w+([-.]\w+)*\.\w+([-.]\w+)*"
                                ValidationGroup="vgContact"></asp:RegularExpressionValidator>
                            <asp:TextBox ID="txtMessage" runat="server" TextMode="MultiLine" CssClass="contact_txtarea" onkeyup="countChar(this)" placeholder="WRITE YOUR MESSAGE (140 CHAR)" MaxLength="150"></asp:TextBox>
                            <asp:RequiredFieldValidator ID="rfvMessage" runat="server" ControlToValidate="txtMessage"
                                ErrorMessage="Please Enter Message" SetFocusOnError="true" Display="None"
                                ValidationGroup="vgContact"></asp:RequiredFieldValidator>
                            <asp:RegularExpressionValidator ID="RegularExpressionValidator1" runat="server" ControlToValidate="txtName" ForeColor="Red"
                                ValidationExpression="[a-zA-Z0-9_\s]*$" ErrorMessage="*Valid characters: Alphabets and Numbers." SetFocusOnError="true" Display="None"
                                ValidationGroup="vgContact" />

                            <asp:RegularExpressionValidator ID="RegularExpressionValidator2" runat="server" ControlToValidate="txtMessage" ForeColor="Red"
                                ValidationExpression="[a-zA-Z0-9,._\s]*$" ErrorMessage="*Valid characters: Alphabets and Numbers." SetFocusOnError="true" Display="None"
                                ValidationGroup="vgContact" />
                            <AjaxToolkit:FilteredTextBoxExtender ID="FilteredTextBoxExtender1" runat="server" TargetControlID="txtName" FilterMode="InvalidChars" InvalidChars="&();|~!@#$%^*<>/\{}:';/*+_~`[]=&quot;"></AjaxToolkit:FilteredTextBoxExtender>
                            <AjaxToolkit:FilteredTextBoxExtender ID="FilteredTextBoxExtender2" runat="server" TargetControlID="txtEmail" FilterMode="InvalidChars" InvalidChars=";|~!#$%^*<>/\{}:';/*+_~`[]=&quot;()&"></AjaxToolkit:FilteredTextBoxExtender>
                            <AjaxToolkit:FilteredTextBoxExtender ID="FilteredTextBoxExtender3" runat="server" TargetControlID="txtMessage" FilterMode="InvalidChars" InvalidChars=";|~!@#$%^*<>/\{}:';/*+_~`[]=&quot;"></AjaxToolkit:FilteredTextBoxExtender>
                            <div class="submit_btn">
                                <asp:LinkButton ID="btnSubmit" runat="server" ValidationGroup="vgContact" OnClick="btnSubmit_Click">
                                <h4>SUBMIT</h4>
                                </asp:LinkButton>
                                <asp:ValidationSummary ID="vsSubmit" runat="server" ValidationGroup="vgContact"
                                    ShowMessageBox="true" ShowSummary="false" HeaderText="Please rectify following error(s):" />
                            </div>
                            <div class="remaining_char">
                                <p>
                                    <label id="charNum">140</label>
                                    Characters Remaining
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
