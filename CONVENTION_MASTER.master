    <script>
        // Show/hide main mobile menu
        function toggleMenu() {
            document.getElementById("menuLinks").classList.toggle("show");
        }

        // Toggle dropdowns only on mobile
        function toggleDropdown(e) {
            if (window.innerWidth <= 768) {
                e.preventDefault(); // prevent anchor click
                const parent = e.target.closest("li");
                parent.classList.toggle("show-dropdown");
            }
        }

        // Optional: Close dropdowns on window resize
        window.addEventListener("resize", () => {
            if (window.innerWidth > 768) {
                document.querySelectorAll(".menu-links li").forEach(li => {
                    li.classList.remove("show-dropdown");
                });
            }
        });
    </script>

